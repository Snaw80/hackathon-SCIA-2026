# Copy to .env at the repository root. Default: no external model calls.
MELTDOWN_AGENT_MODE=rules
MELTDOWN_DB=.data/meltdown.sqlite

# For live agents: set mode to llm and a LangChain provider:model identifier.
MELTDOWN_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: set this in web/.env.local if the backend uses another address.
# MELTDOWN_API_URL=http://127.0.0.1:8000
