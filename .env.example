# Copy to .env at the repository root. An LLM provider key is required.
MELTDOWN_DB=.data/meltdown.sqlite

# Evaluated low-cost setup; see docs/model-calibration.md.
# Set a LangChain provider:model identifier and its provider key.
MELTDOWN_MODEL=openai:gpt-5.6-luna
MELTDOWN_REASONING_EFFORT=none
MELTDOWN_MAX_OUTPUT_TOKENS=384
MELTDOWN_TIMEOUT_SECONDS=20
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: set this in web/.env.local if the backend uses another address.
# MELTDOWN_API_URL=http://127.0.0.1:8000
